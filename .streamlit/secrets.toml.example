# Cole este conteúdo em: Streamlit Cloud > app > Settings > Secrets (com os valores reais).
ANTHROPIC_API_KEY = "sk-ant-..."
# Voz — o app tenta nesta ordem e só usa a próxima se a anterior falhar.
# Todas opcionais; sem nenhuma, o microfone fica desligado (a voz grátis do Edge funciona sem chave).
GROQ_API_KEY = "gsk_..."     # grátis: console.groq.com
GEMINI_API_KEY = "AIza..."   # aistudio.google.com
OPENAI_API_KEY = "sk-..."    # pago, reserva final

# Registro de uso e histórico (Neon → projeto → Connect → copiar a connection string)
DATABASE_URL = "postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Quem pode entrar no app (e-mails Google)
ALLOWED_EMAILS = ["seu-email@gmail.com"]

# Login com Google
[auth]
redirect_uri = "https://tony-english-practice.streamlit.app/oauth2callback"
cookie_secret = "uma-frase-longa-e-aleatoria"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
